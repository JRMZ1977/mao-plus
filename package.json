{
  "name": "mao-plus",
  "version": "1.3.0",
  "description": "MAO Plus — Análisis morfométrico de objetos arqueológicos. Aplicación de escritorio para macOS con Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "package": "electron-builder --mac",
    "launcher": "bash scripts/build-dev-launcher.sh",
    "test": "npm run test:esm && npm run test:js && npm run test:py",
    "test:esm": "node scripts/check-esm.mjs",
    "test:js": "node tests/test_window_contracts.js && node tests/test_shape_classification.mjs && node tests/test_efa_tps_export.js && node tests/test_bifacial_export.js && node tests/test_export_destino.js",
    "test:py": "bash scripts/run-pytest.sh",
    "glosario": "node scripts/generar-glosario-html.mjs",
    "glosario:inventario": "python3 scripts/glosario_inventario.py --md docs/GLOSARIO-INVENTARIO-F0.md",
    "verificar:visual": "node tools/verificacion_visual_electron.mjs"
  },
  "keywords": [
    "electron",
    "desktop",
    "macOS",
    "arqueología",
    "morfometría"
  ],
  "author": "Quipus / Juan Francisco Ramírez",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^24.9.1",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "com.maoplus.desktop",
    "productName": "MAO Plus",
    "mac": {
      "category": "public.app-category.education",
      "icon": "icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "runtime",
        "to": "python-runtime"
      },
      {
        "from": "python",
        "to": "python"
      }
    ],
    "dmg": {
      "title": "MAO Plus",
      "iconSize": 100,
      "contents": [
        {
          "x": 380,
          "y": 280,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 110,
          "y": 280,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 480
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "libs/**/*",
      "assets/**/*",
      "python/**/*",
      "requirements.txt",
      "start_server.sh",
      "!.venv/**/*",
      "!**/*.bak",
      "!**/*.backup*",
      "!.pytest_cache/**/*",
      "!tests/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
